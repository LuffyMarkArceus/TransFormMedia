# Server
SERVER_PORT=8080

# Comma-separated browser origins allowed to call the API with credentials
ALLOWED_ORIGINS=http://localhost:3000

# Clerk JWT validation (issuer URL, no trailing slash)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Secret used to HMAC signed share URLs (required, min 16 chars).
# Generate with: openssl rand -hex 32
SHARE_SECRET=replace-me-with-32-random-hex-chars

# Neon / Postgres
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Redis (optional — the service runs without a cache when unset)
# REDIS_URL=redis://default:password@host:6379/0

# Async worker behavior
# WORKER_RETRY_BASE_SECONDS=30   # base backoff between processing attempts
# WORKER_MAX_ATTEMPTS=5          # attempts before an item is marked failed

# Cloudflare R2 (S3-compatible)
R2_BUCKET=your-bucket
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ACCOUNT_ID=
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
